{
  "name": "sci-dsh-ocean-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A reproducible ocean SST demonstration running inside DeepSeek Harness.",
  "engines": { "node": ">=22" },
  "scripts": {
    "demo": "node scripts/run-harness.mjs",
    "dsh": "node scripts/run-harness.mjs",
    "web": "node scripts/run-harness.mjs --web",
    "harness:check": "node scripts/run-harness.mjs --check",
    "test:harness": "node --test tests/harness-adapter.test.mjs tests/gallery.test.mjs tests/workflow-order.test.mjs",
    "data:prepare": "node scripts/local-step.mjs data",
    "plot:A": "node scripts/local-step.mjs plot-A",
    "plot:B": "node scripts/local-step.mjs plot-B",
    "plot:gap": "node scripts/local-step.mjs plot-gap",
    "skill:export": "node scripts/local-step.mjs export",
    "skill:manage": "node scripts/local-step.mjs skill",
    "results:compare": "node scripts/local-step.mjs compare",
    "test:analysis": "node scripts/local-step.mjs test"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7"
  }
}
