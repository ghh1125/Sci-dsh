# Copy this file to .env and fill in values locally. Never commit .env.
# The user verified this model API endpoint on Windows (see STATUS.md).
# Check the provider's current base URL and model access on each new device.
SCI_DSH_BASE_URL=https://token.fncompute.com/v1

# Required: exact model identifier offered by your proxy. No default is guessed.
SCI_DSH_MODEL=

# Required: paste your own key only into the local .env or process environment.
SCI_DSH_API_KEY=

# Optional: use an existing Python with numpy and matplotlib installed.
# SCI_DSH_PYTHON=/absolute/path/to/python
# SST_PYTHON is accepted as an alternative.

# Optional, DATA downloads only. This is NOT the model API gateway above.
# Use the HTTP/HTTPS proxy address actually provided by your proxy software.
# The port below is only an example. Leave unset when no proxy is needed.
# SCI_DSH_DATA_PROXY=http://127.0.0.1:7890

# Optional organization CA bundle in PEM format, for trusted corporate proxies.
# Default system trust and certifi remain enabled. Never disable TLS validation.
# SCI_DSH_DATA_CA_BUNDLE=C:/certs/organization-ca.pem
# Standard HTTPS_PROXY/HTTP_PROXY/NO_PROXY and system proxy settings are also
# supported when SCI_DSH_DATA_PROXY is unset. Do not commit proxy credentials.
